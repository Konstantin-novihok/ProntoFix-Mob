# Разметка интерфейса (язык KV). Здесь только внешний вид; логика — в main.py.
# Тексты берутся из переводов:  app.tr('ключ')  — меняются на лету при смене языка.

<Btn@Button>:
    size_hint_y: None
    height: dp(48)

<Row@Button>:                      # строка списка (заказ, пользователь...)
    size_hint_y: None
    height: dp(72)
    halign: 'left'
    valign: 'middle'
    markup: True
    text_size: self.width - dp(20), None
    background_color: .2, .25, .3, 1

<Field@TextInput>:
    size_hint_y: None
    height: dp(44)
    multiline: False

<Lbl@Label>:                       # многострочная подпись с автовысотой
    size_hint_y: None
    height: self.texture_size[1] + dp(8)
    text_size: self.width, None
    halign: 'left'
    markup: True

<ListScreen>:                      # универсальный экран «заголовок + список + кнопки»
    BoxLayout:
        orientation: 'vertical'
        padding: dp(8)
        spacing: dp(6)
        Nav:
        Label:
            text: root.title
            size_hint_y: None
            height: dp(36)
            font_size: '18sp'
            bold: True
        ScrollView:
            GridLayout:
                id: list
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
        BoxLayout:
            id: actions
            size_hint_y: None
            height: dp(48)
            spacing: dp(4)

<LoginScreen>:
    name: 'login'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)
        Label:
            text: app.tr('app_title')
            font_size: '24sp'
            size_hint_y: None
            height: dp(70)
        Field:
            id: user
            hint_text: app.tr('username')
        Field:
            id: pwd
            hint_text: app.tr('password')
            password: True
        Btn:
            text: app.tr('login')
            on_release: app.login(user.text, pwd.text)
        Btn:
            text: app.tr('register')
            on_release: app.open_register()
        Btn:
            text: app.tr('language')
            on_release: app.pick_language()
        Widget:

<Section@Label>:                   # заголовок раздела формы
    size_hint_y: None
    height: dp(34)
    bold: True
    color: .55, .8, 1, 1
    text_size: self.width, None
    halign: 'left'
    valign: 'bottom'

<RegisterScreen>:
    name: 'register'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(6)
        Label:
            text: app.tr('register')
            font_size: '20sp'
            bold: True
            size_hint_y: None
            height: dp(40)
        ScrollView:
            GridLayout:
                id: form
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(6)
                Section:
                    text: app.tr('section_account')
                Field:
                    id: user
                    hint_text: app.tr('username')
                Field:
                    id: pwd
                    hint_text: app.tr('password')
                    password: True
                Section:
                    text: app.tr('section_person')
                Field:
                    id: fname
                    hint_text: app.tr('full_name')
                Field:
                    id: phone
                    hint_text: app.tr('phone')
                    input_type: 'tel'
                Section:
                    text: app.tr('section_company')
                Field:
                    id: company
                    hint_text: app.tr('company_name')
                Field:
                    id: website
                    hint_text: app.tr('website')
                    input_type: 'url'
                Field:
                    id: address
                    hint_text: app.tr('address')
                Btn:
                    text: app.tr('use_gps')
                    on_release: app.use_gps('reg')
                Btn:
                    text: app.tr('set_location')
                    on_release: app.pick_reg_location()
                Lbl:
                    id: loc
                    color: .7, 1, .7, 1
                Section:
                    text: app.tr('section_passport')
                Field:
                    id: pnum
                    hint_text: app.tr('passport_number')
                Field:
                    id: pissued
                    hint_text: app.tr('passport_issued')
                Section:
                    text: app.tr('section_documents')
                Btn:
                    text: app.tr('take_photo')
                    on_release: app.open_camera(app.add_reg_files)
                Btn:
                    text: app.tr('choose_document')
                    on_release: app.choose_documents(app.add_reg_files)
                GridLayout:
                    id: docs
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(4)
                Lbl:
                    text: app.tr('privacy_note')
                    font_size: '12sp'
                    color: .7, .7, .7, 1
                BoxLayout:
                    size_hint_y: None
                    height: dp(48)
                    CheckBox:
                        id: consent
                        size_hint_x: None
                        width: dp(48)
                    Label:
                        text: app.tr('consent')
                        text_size: self.width, None
                        halign: 'left'
                        valign: 'middle'
        Btn:
            text: app.tr('register')
            on_release: app.do_register()
        Btn:
            text: app.tr('back')
            on_release: app.root.current = 'login'

<OrderScreen>:                     # карточка заказа; содержимое строится в main.py (show_order)
    name: 'order'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(8)
        spacing: dp(6)
        Nav:
        ScrollView:
            GridLayout:
                id: body
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(6)

<OrderNewScreen>:
    name: 'order_new'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(8)
        Nav:
        ScrollView:
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(6)
                Field:
                    id: title
                    hint_text: app.tr('title')
                TextInput:
                    id: descr
                    hint_text: app.tr('description')
                    size_hint_y: None
                    height: dp(120)
                Field:
                    id: address
                    hint_text: app.tr('address')
                Btn:
                    text: app.tr('department')
                    on_release: app.pick_new_department()
                Btn:
                    text: app.tr('client')
                    disabled: not app.can_pick_client
                    opacity: 1 if app.can_pick_client else 0
                    on_release: app.pick_new_client()
                Btn:
                    text: app.tr('set_location')
                    on_release: app.pick_location()
                Btn:
                    text: app.tr('use_gps')
                    on_release: app.use_gps('new')
                Btn:
                    text: app.tr('attach_file')
                    on_release: app.pick_files_new()
                Lbl:
                    id: summary
                Btn:
                    text: app.tr('submit')
                    on_release: app.submit_order(title.text, descr.text, address.text)

<MapScreen>:
    name: 'map'
    FloatLayout:
        MapView:
            id: mv
            zoom: 15
        Label:                      # перекрестие в центре карты (для выбора точки)
            id: cross
            text: '+'
            font_size: '40sp'
            color: 1, 0, 0, 1
            size_hint: None, None
            size: dp(40), dp(40)
            pos_hint: {'center_x': .5, 'center_y': .5}
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            spacing: dp(4)
            pos_hint: {'x': 0, 'y': 0}
            Btn:
                text: app.tr('back')
                text_size: self.width - dp(8), None
                halign: 'center'
                valign: 'middle'
                font_size: '13sp'
                on_release: app.map_back()
            Btn:
                id: setbtn
                text: app.tr('set_here')
                text_size: self.width - dp(8), None
                halign: 'center'
                valign: 'middle'
                font_size: '13sp'
                on_release: app.map_set()
            Btn:
                text: app.tr('open_external')
                text_size: self.width - dp(8), None
                halign: 'center'
                valign: 'middle'
                font_size: '13sp'
                on_release: app.map_external()
